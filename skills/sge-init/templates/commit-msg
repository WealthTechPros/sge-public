#!/usr/bin/env sh
# SGE change protocol: commit-msg hook, enforcement-profile aware (SPEC-128).
# sge-commit-msg: enforcement-profile-aware (SPEC-128)
#
# Every commit should carry either a `Spec: <SPEC|SGD|SGE>-NNN` trailer or an
# `SGE-Override: <STEP>; <reason>` trailer, so each commit traces back to an
# approved spec (or records an intentional bypass). What happens when neither
# is present depends on the repo's enforcement profile in .sge/posture.yaml:
#
#   onboarding (the default: no file, or no `enforcement:` key)
#       warns and lets the commit through.
#   enforced
#       rejects the commit, naming the missing trailer. A live (unexpired)
#       `commit-msg` entry under `enforcement_exceptions:` lets it through and
#       prints the exception as audit evidence.
#
# The profile is read with the SGE plugin's scripts/read-enforcement-profile.sh.
# This hook runs outside Claude, so it looks for that reader itself (see
# find_reader below). Fail closed: if posture.yaml declares an `enforcement:`
# key and the reader cannot be found, or the reader reports an error, the
# commit is rejected. It never falls back to onboarding in that case.
#
# Scaffolded by /sge:sge-init. See docs/sge/change-protocol.md and the plugin's
# skills/sge-init/references/enforcement-profile-local-gates.md.

COMMIT_MSG_FILE="$1"

# Skip empty templates (git aborts an empty commit anyway).
if [ ! -s "$COMMIT_MSG_FILE" ]; then
  exit 0
fi

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
POSTURE="$ROOT/.sge/posture.yaml"
TODAY="${SGE_TODAY:-$(date +%Y-%m-%d)}"

# find_reader: print the path of read-enforcement-profile.sh, or nothing.
# Order: explicit override, plugin-root env vars, a copy in this repo, then the
# Claude Code plugin dirs under $HOME: a marketplace checkout if present, else
# the HIGHEST cached version by version order (sort -V: 4.38.10 > 4.38.9),
# never the lexically last glob match.
find_reader() {
  if [ -n "${SGE_ENFORCEMENT_READER:-}" ]; then
    [ -f "$SGE_ENFORCEMENT_READER" ] && printf '%s\n' "$SGE_ENFORCEMENT_READER"
    return 0
  fi
  for c in "${SGE_PLUGIN_ROOT:-}" "${CLAUDE_PLUGIN_ROOT:-}" "$ROOT"; do
    if [ -n "$c" ] && [ -f "$c/scripts/read-enforcement-profile.sh" ]; then
      printf '%s\n' "$c/scripts/read-enforcement-profile.sh"; return 0
    fi
  done
  found=""
  for c in "$HOME"/.claude/plugins/marketplaces/*/scripts/read-enforcement-profile.sh; do
    [ -f "$c" ] && found="$c"
  done
  if [ -z "$found" ]; then
    # "<version><TAB><path>" per cached copy, version-sorted, highest last.
    found="$(for c in "$HOME"/.claude/plugins/cache/*/sge/*/scripts/read-enforcement-profile.sh; do
        [ -f "$c" ] || continue
        v="${c%/scripts/read-enforcement-profile.sh}"; v="${v##*/}"
        printf '%s\t%s\n' "$v" "$c"
      done | sort -t "$(printf '\t')" -k1,1V 2>/dev/null | tail -n 1 | cut -f2-)"
  fi
  [ -n "$found" ] && printf '%s\n' "$found"
  return 0
}

# declares_enforcement_raw: with no reader, could posture.yaml declare a
# profile? Mirrors the reader's fail-closed class: CRs become line breaks and
# NULs are dropped (so CR-only and UTF-16 files are read), whole-line comments
# are ignored, and any other line mentioning `enforcement`, or holding an
# escape inside double quotes, counts as a declaration.
declares_enforcement_raw() {
  tr '\r' '\n' < "$POSTURE" | tr -d '\000' | LC_ALL=C grep -av '^[[:space:]]*#' \
    | LC_ALL=C grep -aq -e 'enforcement' -e '".*\\' -e '\\.*"'
}

reject() {
  printf '\n✖  SGE: commit rejected (enforcement profile).\n\n%s\n\n' "$1" >&2
  exit 1
}

PROFILE=onboarding
EXCEPTION=""
EXPIRED=""
if [ -e "$POSTURE" ]; then
  READER="$(find_reader)"
  if [ -n "$READER" ]; then
    if ! PROFILE_OUT="$(bash "$READER" "$ROOT" 2>&1)"; then
      reject "Cannot read the enforcement profile in .sge/posture.yaml:
  $PROFILE_OUT
Fix .sge/posture.yaml. The hook fails closed rather than assume onboarding."
    fi
    PROFILE="$(printf '%s\n' "$PROFILE_OUT" | awk -F '\t' '$1 == "enforcement" { print $2 }')"
    EXCEPTION="$(printf '%s\n' "$PROFILE_OUT" | awk -F '\t' -v t="$TODAY" \
      '$1 == "exception" && NF == 5 && $5 ~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/ && $2 == "commit-msg" && $5 >= t { print $3 " (" $4 ", until " $5 ")"; exit }')"
    EXPIRED="$(printf '%s\n' "$PROFILE_OUT" | awk -F '\t' -v t="$TODAY" \
      '$1 == "exception" && NF == 5 && $5 ~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/ && $2 == "commit-msg" && $5 < t { print $3 " (" $4 ", expired " $5 ")"; exit }')"
  elif declares_enforcement_raw; then
    # A non-comment mention of the key -- including a BOM-prefixed, quoted,
    # flow-mapping, CR-only or UTF-16 form -- may declare enforced: with no
    # reader to tell, fail closed rather than guess onboarding. Comment-only
    # mentions (the shipped posture.yaml template) stay onboarding.
    reject ".sge/posture.yaml declares an enforcement profile, but the SGE plugin's
read-enforcement-profile.sh was not found (looked in SGE_ENFORCEMENT_READER,
SGE_PLUGIN_ROOT, CLAUDE_PLUGIN_ROOT, scripts/ in this repo, and
~/.claude/plugins). Install the SGE plugin or set SGE_PLUGIN_ROOT to its
directory. The hook fails closed rather than assume onboarding."
  fi
fi

# Skip merge commits, fixups, squashes and reverts -- judged by the SUBJECT
# line only (the first non-blank line, `#` lines INCLUDED: with -m/-F git
# keeps a `#` line, so it is the real subject), with the trailing space the
# CI gate uses, and only AFTER the profile was read so a malformed profile
# still fails closed. A body line starting "Merge" is not a merge. In the
# editor flow a leading comment line just means "not skipped" (fails safe).
SUBJECT="$(grep -v '^[[:space:]]*$' "$COMMIT_MSG_FILE" | head -n 1)"
case "$SUBJECT" in
  "Merge "*|"fixup! "*|"squash! "*|"Revert "*) exit 0 ;;
esac

# Accept either repo's spec-id convention: SPEC-NNN, or legacy SGD-NNN /
# newly-minted SGE-NNN.
if grep -qE '^Spec:\s*(SPEC|SGD|SGE)-[0-9]+' "$COMMIT_MSG_FILE"; then
  exit 0
fi
# Accept the SGE-Override trailer (and the legacy SGD-Override spelling, so
# historical commits keep validating).
if grep -qE '^(SGD|SGE)-Override:\s*[A-Z]+;\s*.{10,}' "$COMMIT_MSG_FILE"; then
  exit 0
fi

TRAILER_HELP='Add one of the following trailers to the commit message:

  Spec: SPEC-NNN          (or SGD-NNN)
    Link this commit to the feature spec it implements.

  SGE-Override: <STEP>; <reason, ≥10 chars>
    Intentional bypass (governance/infra/docs change with no single spec).
    Logged for audit. STEP ∈ { LOCATE, READ, IMPACT, PROPOSE, IMPLEMENT, TEST, UPDATE, ALL }'

if [ "$PROFILE" = "enforced" ]; then
  if [ -n "$EXCEPTION" ]; then
    printf '\nSGE: EXCEPTION commit-msg: %s\n' "$EXCEPTION"
    printf 'Commit allowed without a Spec:/SGE-Override: trailer under the dated exception in .sge/posture.yaml.\n\n'
    exit 0
  fi
  note=""
  [ -n "$EXPIRED" ] && note="
The commit-msg exception in .sge/posture.yaml has expired: $EXPIRED.
An expired exception counts as absent. Renew it in a reviewed PR or remove it."
  reject "Missing trailer: neither 'Spec:' nor 'SGE-Override:' is present, and this
repo declares enforcement: enforced in .sge/posture.yaml.
$note
$TRAILER_HELP

See docs/sge/change-protocol.md."
fi

cat <<EOF

⚠️  SGE warning — commit lacks a change-protocol trailer.

$TRAILER_HELP

This is a warning only: the repo's enforcement profile is onboarding, so the
commit continues. To make it blocking, follow the promotion path and set
\`enforcement: enforced\` in .sge/posture.yaml. See docs/sge/change-protocol.md.

EOF

exit 0
