{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ". \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" \"${CLAUDE_PLUGIN_ROOT}/hooks/cortex-recall.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ". \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" \"${CLAUDE_PLUGIN_ROOT}/hooks/token-meter.sh\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ". \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" \"${CLAUDE_PLUGIN_ROOT}/hooks/token-meter.sh\""
          }
        ]
      }
    ]
  }
}
